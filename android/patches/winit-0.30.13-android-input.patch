+    fn dispatch_window_event<F>(&self, callback: &mut F, event: event::WindowEvent)
+    where
+        F: FnMut(event::Event<T>, &RootAEL),
+    {
+        let event = event::Event::WindowEvent { window_id: window::WindowId(WindowId), event };
+        callback(event, self.window_target());
+    }
+
+    /// Keep winit's modifier state in step with the meta state Android reports on every key
+    /// and motion event, so Ctrl/Shift/Alt shortcuts work from a hardware keyboard.
+    fn sync_modifiers<F>(&mut self, meta: MetaState, callback: &mut F)
+    where
+        F: FnMut(event::Event<T>, &RootAEL),
+    {
+        let mut state = ModifiersState::empty();
+        state.set(ModifiersState::SHIFT, meta.shift_on());
+        state.set(ModifiersState::CONTROL, meta.ctrl_on());
+        state.set(ModifiersState::ALT, meta.alt_on());
+        state.set(ModifiersState::SUPER, meta.meta_on());
+        if state != self.modifiers {
+            self.modifiers = state;
+            self.dispatch_window_event(callback, event::WindowEvent::ModifiersChanged(state.into()));
+        }
+    }
+
+    /// Mouse hover, buttons and wheel (`TOOL_TYPE_MOUSE` motion events).
+    fn handle_mouse_motion<F>(&mut self, motion_event: &MotionEvent<'_>, callback: &mut F)
+    where
+        F: FnMut(event::Event<T>, &RootAEL),
+    {
+        let device_id = event::DeviceId(DeviceId(motion_event.device_id()));
+        let pointer = motion_event.pointer_at_index(motion_event.pointer_index());
+        let position = PhysicalPosition { x: pointer.x() as f64, y: pointer.y() as f64 };
+
+        match motion_event.action() {
+            MotionAction::HoverEnter => {
+                self.dispatch_window_event(callback, event::WindowEvent::CursorEntered { device_id });
+            },
+            MotionAction::HoverExit => {
+                self.dispatch_window_event(callback, event::WindowEvent::CursorLeft { device_id });
+                return;
+            },
+            _ => {},
+        }
+
+        self.dispatch_window_event(callback, event::WindowEvent::CursorMoved { device_id, position });
+
+        if motion_event.action() == MotionAction::Scroll {
+            // Axes other than X/Y must be enabled on the AndroidApp (`enable_motion_axis`).
+            let delta = event::MouseScrollDelta::LineDelta(
+                pointer.axis_value(Axis::Hscroll),
+                pointer.axis_value(Axis::Vscroll),
+            );
+            self.dispatch_window_event(callback, event::WindowEvent::MouseWheel {
+                device_id,
+                delta,
+                phase: event::TouchPhase::Moved,
+            });
+            return;
+        }
+
+        // Buttons: report whatever changed against the last event. This covers DOWN, UP and
+        // BUTTON_PRESS/RELEASE alike, including a second button pressed while one is held.
+        let held = if motion_event.action() == MotionAction::Cancel {
+            [false; 5]
+        } else {
+            let b = motion_event.button_state();
+            [b.primary(), b.secondary(), b.teriary(), b.back(), b.forward()]
+        };
+        const BUTTONS: [event::MouseButton; 5] = [
+            event::MouseButton::Left,
+            event::MouseButton::Right,
+            event::MouseButton::Middle,
+            event::MouseButton::Back,
+            event::MouseButton::Forward,
+        ];
+        for (i, button) in BUTTONS.into_iter().enumerate() {
+            if held[i] != self.mouse_buttons[i] {
+                let state = if held[i] {
+                    event::ElementState::Pressed
+                } else {
+                    event::ElementState::Released
+                };
+                self.dispatch_window_event(callback, event::WindowEvent::MouseInput {
+                    device_id,
+                    state,
+                    button,
+                });
+            }
+        }
+        self.mouse_buttons = held;
+    }
+
