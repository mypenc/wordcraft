+        let added: String = new_chars[prefix..new_chars.len() - suffix].iter().filter(|c| **c != '\n' && **c != '\r').collect();
+
+        let old_cursor = Self::utf16_char_offset(&old, self.ime_selection.1);
+        let (delete_key, delete_code) = if prefix < old_cursor {
+            (NamedKey::Backspace, KeyCode::Backspace)
+        } else {
+            (NamedKey::Delete, KeyCode::Delete)
+        };
+        for _ in 0..removed {
+            for state in [event::ElementState::Pressed, event::ElementState::Released] {
+                self.dispatch_window_event(callback, event::WindowEvent::KeyboardInput {
+                    device_id: event::DeviceId(DeviceId(0)),
+                    event: event::KeyEvent {
+                        state,
+                        physical_key: PhysicalKey::Code(delete_code),
+                        logical_key: Key::Named(delete_key),
+                        location: KeyLocation::Standard,
+                        repeat: false,
+                        text: None,
+                        platform_specific: KeyEventExtra {},
+                    },
+                    is_synthetic: false,
+                });
+            }
+        }
+        if !added.is_empty() {
+            self.dispatch_window_event(callback, event::WindowEvent::Ime(event::Ime::Commit(added)));
+        }
+        for _ in 0..extra_enters.min(64) {
+            for state in [event::ElementState::Pressed, event::ElementState::Released] {
+                self.dispatch_window_event(callback, event::WindowEvent::KeyboardInput {
+                    device_id: event::DeviceId(DeviceId(0)),
+                    event: event::KeyEvent {
+                        state,
+                        physical_key: PhysicalKey::Code(KeyCode::Enter),
+                        logical_key: Key::Named(NamedKey::Enter),
+                        location: KeyLocation::Standard,
+                        repeat: false,
+                        text: None,
+                        platform_specific: KeyEventExtra {},
+                    },
+                    is_synthetic: false,
+                });
+            }
+        }
+
+        let selection = (state.selection.start, state.selection.end);
+        if old.as_str() == text.as_str() && selection.0 == selection.1 && self.ime_selection.0 == self.ime_selection.1 {
+            let prior_cursor = Self::utf16_char_offset(text, self.ime_selection.1);
+            let current_cursor = Self::utf16_char_offset(text, selection.1);
+            let (key, code, count) = if current_cursor < prior_cursor {
+                (NamedKey::ArrowLeft, KeyCode::ArrowLeft, prior_cursor - current_cursor)
+            } else {
+                (NamedKey::ArrowRight, KeyCode::ArrowRight, current_cursor - prior_cursor)
+            };
+            for _ in 0..count.min(256) {
+                for state in [event::ElementState::Pressed, event::ElementState::Released] {
+                    self.dispatch_window_event(callback, event::WindowEvent::KeyboardInput {
+                        device_id: event::DeviceId(DeviceId(0)),
+                        event: event::KeyEvent {
+                            state,
+                            physical_key: PhysicalKey::Code(code),
+                            logical_key: Key::Named(key),
+                            location: KeyLocation::Standard,
+                            repeat: false,
+                            text: None,
+                            platform_specific: KeyEventExtra {},
+                        },
+                        is_synthetic: false,
+                    });
+                }
+            }
+        }
+        self.ime_selection = selection;
+
+        // The IME only moves its cursor inside its own buffer, which is not the document: with
+        // the cursor at an edge, arrow keys and Gboard's space-bar slide would send nothing. Keep
+        // blank room on both sides, topped up whenever the cursor nears an edge (never while a
+        // word is being composed) or the buffer grows large.
+        let cursor = Self::utf16_char_offset(&self.ime_text, selection.1);
+        let total = self.ime_text.chars().count();
+        let near_edge = cursor < IME_PAD_MIN || total.saturating_sub(cursor) < IME_PAD_MIN;
+        if state.compose_region.is_none() && (near_edge || total > 4096) {
+            self.pad_ime_buffer(android_app);
+        }
+    }
+
+    /// Reset the IME's buffer to blank padding with the cursor in the middle.
+    fn pad_ime_buffer(&mut self, android_app: &AndroidApp) {
+        self.ime_text = " ".repeat(IME_PAD * 2);
+        self.ime_selection = (IME_PAD, IME_PAD);
+        android_app.set_text_input_state(TextInputState {
+            text: self.ime_text.clone(),
+            selection: TextSpan { start: IME_PAD, end: IME_PAD },
+            compose_region: None,
+        });
+    }
+
+    fn utf16_char_offset(text: &str, offset: usize) -> usize {
+        let mut units = 0;
+        let mut chars = 0;
+        for ch in text.chars() {
+            let next = units + ch.len_utf16();
+            if next > offset {
+                break;
+            }
+            units = next;
+            chars += 1;
+        }
+        chars
+    }
