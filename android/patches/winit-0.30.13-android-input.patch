+/// Blank characters kept on each side of the IME cursor, and the margin that triggers a top-up.
+const IME_PAD: usize = 64;
+const IME_PAD_MIN: usize = 8;
+
+/// A short-lived count of key presses waiting for their echo from the other input path.
+#[derive(Debug, Default)]
+struct PendingKeys {
+    count: usize,
+    stamp: Option<Instant>,
+}
+
+impl PendingKeys {
+    const TTL: Duration = Duration::from_millis(250);
+
+    fn live(&mut self) -> usize {
+        if self.stamp.is_some_and(|t| t.elapsed() > Self::TTL) {
+            self.count = 0;
+            self.stamp = None;
+        }
+        self.count
+    }
+
+    fn add(&mut self, n: usize) {
+        if n > 0 {
+            self.live();
+            self.count += n;
+            self.stamp = Some(Instant::now());
+        }
+    }
+
+    fn take(&mut self, n: usize) -> usize {
+        let m = self.live().min(n);
+        self.count -= m;
+        m
+    }
 }
 
